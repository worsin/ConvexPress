  "variants": {
    "page": [
      "default",
      "sidebar-left",
      "full-width",
      "no-sidebar",
      "landing",
      "blank"
    ],
    "shop.catalog": [
      "marketplace"
    ],
    "shop.product": [
      "marketplace",
      "classic",
      "showcase"
    ]
  },
  "modules": [
    "colors",
    "typography",
    "layout",
    "header",
    "footer",
    "menuLayout",
    "shop",
    "pageTemplates"
  ],
  "menuLocations": {
    "primary": "header",
    "secondary": "secondary",
    "footer-1": "footer-1",
    "footer-2": "footer-2",
    "footer-3": "footer-3"
  },
  "defaults": {
    "layout": {
      "contentWidth": "full",
      "sectionSpacing": "compact",
      "elementSpacing": "compact",
      "blockGap": "none"
    }
  },
  "presets": {
    "colors": [
