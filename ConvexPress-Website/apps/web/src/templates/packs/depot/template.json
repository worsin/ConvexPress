          "background": "#fbfaf4",
          "foreground": "#25352d",
          "card": "#fbfaf4",
          "card-foreground": "#25352d",
          "primary": "#326d4f",
          "primary-foreground": "#ffffff",
          "secondary": "#e8eee5",
          "secondary-foreground": "#25352d",
          "muted": "#e8eee5",
          "muted-foreground": "#25352d",
          "accent": "#e8eee5",
          "accent-foreground": "#25352d",
          "border": "#b7c9b7",
