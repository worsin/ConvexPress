      "reference/field-guide": [
        "editorial"
      ],
      "blocks/product-collection": [
        "gallery"
      ],
      "core/divider": [
        "original"
      ],
      "core/spacer": [
        "original"
      ]
    },
    "patterns": "./patterns/*.json",
    "renderers": {
      "core/section": "./blocks/core/section.tsx",
      "core/columns": "./blocks/core/columns.tsx",
      "core/feature-grid": "./blocks/core/feature-grid.tsx",
      "core/cta-band": "./blocks/core/cta-band.tsx",
      "core/pricing-cards": "./blocks/core/pricing-cards.tsx",
      "core/faq": "./blocks/core/faq.tsx",
      "core/testimonials": "./blocks/core/testimonials.tsx",
      "core/hero": "./blocks/core/hero.tsx",
      "core/hero-split": "./blocks/core/hero-split.tsx",
      "core/media-text": "./blocks/core/media-text.tsx",
      "blocks/page-banner": "./blocks/blocks/page-banner.tsx",
      "core/form": "./blocks/core/form.tsx",
