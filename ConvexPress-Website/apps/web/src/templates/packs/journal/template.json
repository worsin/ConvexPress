{
  "id": "journal",
  "name": "Journal",
  "version": "1.0.0",
  "sdk": "^1",
  "tagline": "Editorial. Calm. Centred.",
  "description": "An editorial storefront: a magazine that happens to sell things. Display-type headlines, a centred reading measure, rules instead of boxes, and generous whitespace. The catalog is a three-up boutique grid with text-link filters; the product page is a split layout with a sticky image; the cart reads like a receipt.",
  "author": "ConvexPress",
  "bestFor": [
    "Small catalogs",
    "Content-led brands",
    "Considered purchases"
  ],
  "surfaces": [
    "chrome.header",
    "chrome.mobileNav",
    "chrome.footer",
    "system.notFound",
    "home",
    "page",
    "blog.index",
    "blog.post",
    "shop.catalog",
    "shop.product",
    "cart"
  ],
  "variants": {
    "page": [
      "default",
      "sidebar-left",
      "full-width",
      "no-sidebar",
      "landing",
      "blank"
    ],
    "shop.catalog": [
      "boutique"
    ],
    "shop.product": [
      "split",
      "classic",
      "minimal"
    ]
  },
  "modules": [
    "colors",
    "typography",
    "layout",
    "header",
    "footer",
    "shop",
    "pageTemplates"
  ],
  "menuLocations": {
    "primary": "header",
    "footer-1": "footer-1",
    "footer-2": "footer-2",
    "footer-3": "footer-3"
  },
  "defaults": {
    "layout": {
      "contentWidth": "wide"
    }
  }
}
