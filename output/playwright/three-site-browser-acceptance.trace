    - generic [ref=f3e735]: en-US\n                        - img [aria-hidden] [ref=f3e736]: ▼\n                      - textbox [aria-hidden] [ref=f3e738]: en-US\n                  - generic [ref=f3e739]:\n                    - generic [ref=f3e740]: Timezone\n                    - button \"America/New_York (Eastern)\" [ref=f3e745]\n                  - generic [ref=f3e750]:\n                    - generic [ref=f3e751]: Date Format\n                    - generic [ref=f3e755]:\n                      - radiogroup \"dateFormat\" [ref=f3e756]:\n                        - generic [ref=f3e757] [cursor=pointer]:\n                          - generic [ref=f3e758]:\n                            - radio [checked] [ref=f3e759]\n                            - radio [checked] [aria-hidden] [ref=f3e761]\n                          - generic [ref=f3e762]: MMMM d, yyyy\n                        - generic [ref=f3e764] [cursor=pointer]:\n                          - generic [ref=f3e765]:\n                            - radio [ref=f3e766]\n                            - radio [aria-hidden] [ref=f3e767]\n                          - generic [ref=f3e768]: MM/dd/yyyy\n                        - generic [ref=f3e770] [cursor=pointer]:\n                          - generic [ref=f3e771]:\n                            - radio [ref=f3e772]\n                            - radio [aria-hidden] [ref=f3e773]\n                          - generic [ref=f3e774]: dd/MM/yyyy\n                        - generic [ref=f3e776] [cursor=pointer]:\n                          - generic [ref=f3e777]:\n                            - radio [ref=f3e778]\n                            - radio [aria-hidden] [ref=f3e779]\n                          - generic [ref=f3e780]: yyyy-MM-dd\n                        - generic [ref=f3e782] [cursor=pointer]:\n                          - generic [ref=f3e783]:\n                            - radio [ref=f3e784]\n                            - radio [aria-hidden] [ref=f3e785]\n                          - generic [ref=f3e787]:\n                            - text: \"Custom:\"\n                            - textbox \"e.g., dd-MMM-yyyy\" [ref=f3e789]\n                      - textbox [aria-hidden] [ref=f3e790]: MMMM d, yyyy\n                      - generic [ref=f3e791]: Preview:September 2, 2026\n                  - generic [ref=f3e792]:\n                    - generic [ref=f3e793]: Time Format\n                    - generic [ref=f3e797]:\n                      - radiogroup \"timeFormat\" [ref=f3e798]:\n                        - generic [ref=f3e799] [cursor=pointer]:\n                          - generic [ref=f3e800]:\n                            - radio [checked] [ref=f3e801]\n                            - radio [checked] [aria-hidden] [ref=f3e803]\n                          - generic [ref=f3e804]: h:mm a\n                        - generic [ref=f3e806] [cursor=pointer]:\n                          - generic [ref=f3e807]:\n                            - radio [ref=f3e808]\n                            - radio [aria-hidden] [ref=f3e809]\n                          - generic [ref=f3e810]: HH:mm\n                        - generic [ref=f3e812] [cursor=pointer]:\n                          - generic [ref=f3e813]:\n                            - radio [ref=f3e814]\n                            - radio [aria-hidden] [ref=f3e815]\n                          - generic [ref=f3e816]: HH:mm:ss\n                        - generic [ref=f3e818] [cursor=pointer]:\n                          - generic [ref=f3e819]:\n                            - radio [ref=f3e820]\n                            - radio [aria-hidden] [ref=f3e821]\n                          - generic [ref=f3e823]:\n                            - text: \"Custom:\"\n                            - textbox \"e.g., h:mm:ss a\" [ref=f3e825]\n                      - textbox [aria-hidden] [ref=f3e826]: h:mm a\n                      - generic [ref=f3e827]: Preview:9:45 PM\n                  - generic [ref=f3e828]:\n                    - generic [ref=