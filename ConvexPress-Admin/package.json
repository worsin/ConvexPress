{
  "name": "convexpress-admin",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "convex": "^1.39.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "test": "bun run test:web && bun run test:backend && bun run test:control && bun run test:desktop && bun run test:contracts && bun run test:tooling",
    "test:web": "bun test ./apps/web/src",
    "test:backend": "bun test ./packages/backend/convex ./packages/backend/canonical-blocks-foundation ./packages/backend/membership-policy-foundation ./packages/backend/scripts",
    "test:control": "bun test ./packages/control-plane/convex",
    "test:desktop": "bun test ./packages/desktop/electron ./packages/desktop/scripts",
    "test:contracts": "bun test ./packages/site-contract/src ./packages/runtime-clients/src",
    "test:tooling": "bun test ./scripts",
    "check:guardrails": "node ../scripts/admin/check-admin-guardrails.mjs",
    "check:blocks": "node ../scripts/admin/check-block-catalog.mjs && node ../scripts/admin/sync-block-contracts.mjs --check",
    "check:smoke": "node ../scripts/admin/check-admin-smoke.mjs",
    "check:smoke:browser": "node ../scripts/admin/admin-browser-smoke.mjs",
    "acceptance:cleanliness": "node packages/desktop/scripts/check-runtime-cleanliness.mjs",
    "dev:native": "turbo -F @convexpress/desktop dev",
    "dev:web": "turbo -F web dev",
    "dev:server": "turbo -F @convexpress-admin/backend dev",
    "dev:setup": "turbo -F @convexpress-admin/backend dev:setup",
    "codegen:control": "node ../scripts/admin/generate-control-bindings.mjs",
    "check:control-bindings": "node ../scripts/admin/generate-control-bindings.mjs --check",
    "create:extension": "node scripts/create-extension.mjs",
    "codegen:site-contracts": "node ../scripts/admin/generate-site-contracts.mjs",
    "check:site-contracts": "node ../scripts/admin/generate-site-contracts.mjs --check && node ../scripts/admin/check-site-contracts.mjs",
    "sync:blocks": "node ../scripts/admin/sync-block-contracts.mjs"
  },
  "dependencies": {
    "@convexpress-admin/env": "workspace:*",
    "dotenv": "catalog:",
    "lowlight": "^3.3.0",
    "sharp": "^0.34.5",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@convexpress-admin/config": "workspace:*",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.13.14",
    "convex": "^1.39.1",
    "turbo": "^2.6.3",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.8",
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}
