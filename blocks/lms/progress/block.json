{
  "name": "lms/progress",
  "title": "Learner progress",
  "description": "Signed-in learner's progress summary.",
  "category": "plugin",
  "role": "content",
  "version": 1,
  "keywords": [
    "progress"
  ],
  "ai": {
    "useFor": "Signed-in learner's progress summary.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "scope",
      "type": "select",
      "options": [
        "course",
        "all"
      ],
      "default": "all"
    },
    {
      "id": "course",
      "type": "reference",
      "of": "course",
      "max": 256,
      "storage": "id"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "lms.progress",
    "args": {
      "scope": "attrs.scope",
      "course": "attrs.course"
    }
  },
  "preview": "Learner progress",
  "examples": [
    {}
  ],
  "requires": {
    "plugins": [
      "lms"
    ],
    "capabilities": [
      "viewer.authorization",
      "reference.targetResolution"
    ]
  }
}
