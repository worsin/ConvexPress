{
  "name": "gallery/recipe-card",
  "title": "Recipe card",
  "description": "Recipe with ingredients, steps and schema.org markup.",
  "category": "plugin",
  "role": "content",
  "version": 1,
  "keywords": [
    "recipe-card"
  ],
  "ai": {
    "useFor": "Recipe with ingredients, steps and schema.org markup.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "recipe",
      "type": "reference",
      "of": "recipe",
      "max": 256,
      "storage": "id"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "recipes.recipe",
    "args": {
      "recipe": "attrs.recipe"
    }
  },
  "preview": "Recipe card",
  "examples": [
    {
      "recipe": "demo-recipe"
    },
    {}
  ],
  "requires": {
    "plugins": [
      "recipes"
    ],
    "capabilities": [
      "reference.targetResolution"
    ]
  }
}
