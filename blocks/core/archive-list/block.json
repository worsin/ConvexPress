{
  "name": "core/archive-list",
  "title": "Archive list",
  "description": "Month or year archive links in the site time zone.",
  "category": "discovery",
  "role": "aside",
  "version": 1,
  "keywords": [
    "archive-list"
  ],
  "ai": {
    "useFor": "Month or year archive links in the site time zone.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "groupBy",
      "type": "select",
      "options": [
        "month",
        "year"
      ],
      "default": "month"
    },
    {
      "id": "limit",
      "type": "number",
      "min": 1,
      "max": 48,
      "integer": true,
      "default": 12
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "content.archive",
    "args": {
      "groupBy": "attrs.groupBy",
      "limit": "attrs.limit"
    }
  },
  "preview": "Archive list",
  "examples": [
    {},
    {
      "groupBy": "year",
      "limit": 6
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": []
  }
}
