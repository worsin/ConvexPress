  "examples": [
    {
      "beforeLabel": "Before",
      "afterLabel": "After"
    },
    {
      "before": {
        "id": "demo-image-before",
        "alt": "Synthetic comparison fixture before the change"
      },
      "after": {
        "id": "demo-image-after",
        "alt": "Synthetic comparison fixture after the change"
      },
      "beforeLabel": "Before — sample",
      "afterLabel": "After — sample"
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": [
      "reference.targetResolution"
    ]
  },
  "searchText": [
    [
      "beforeLabel"
    ],
