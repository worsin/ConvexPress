{
  "name": "core/before-after",
  "title": "Before / after",
  "description": "Slider comparing two images.",
  "category": "media",
  "role": "content",
  "version": 1,
  "keywords": [
    "before-after"
  ],
  "ai": {
    "useFor": "Slider comparing two images.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "before",
      "type": "media"
    },
    {
