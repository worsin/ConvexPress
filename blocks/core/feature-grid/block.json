{
  "name": "core/feature-grid",
  "title": "Feature Grid",
  "description": "Grid of feature cards with a section intro.",
  "category": "marketing",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "3–6 features or benefits with short descriptions",
    "avoid": "more than 8 items (consider splitting)"
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 400,
      "multiline": true
    },
    {
      "id": "items",
      "default": [],
      "type": "repeater",
      "max": 12,
      "fields": [
        {
          "id": "icon",
          "type": "icon",
          "options": [
            "book-open",
            "arrow-right",
            "arrow-up-right",
            "check",
            "plus",
            "minus",
            "star",
            "heart",
            "mail",
            "map-pin",
            "calendar",
            "clock",
            "search"
          ],
          "description": "Optional decorative symbol. Not supplied leaves the card without an icon."
        },
        {
          "id": "title",
          "default": "",
          "type": "text",
          "max": 80
        },
        {
          "id": "description",
          "default": "",
          "type": "text",
          "max": 300,
          "multiline": true
        },
        {
          "id": "link",
          "type": "object",
          "title": "Feature link",
          "description": "Optional labeled destination below the feature.",
          "fields": [
            {
              "id": "label",
              "type": "text",
              "title": "Link label",
              "required": true,
              "min": 1,
              "max": 160
            },
            {
              "id": "href",
              "type": "link",
              "title": "Destination",
              "storage": "href",
              "required": true
            },
            {
              "id": "newTab",
              "title": "Open in a new tab",
              "type": "boolean"
            }
          ]
        }
      ]
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": "",
      "items": []
    },
    {
      "eyebrow": "Highlights",
      "heading": "What makes it useful",
      "body": "Three reasons people choose ConvexPress.",
      "items": [
        {
          "title": "AI-first",
          "description": "Type a prompt, get a page.",
          "icon": "star",
          "link": {
            "label": "Explore the studies",
            "href": "#studies"
          }
        },
        {
          "title": "Skill-driven",
          "description": "Themes own the look.",
          "icon": "book-open"
        },
        {
          "title": "Real-time",
          "description": "Powered by Convex.",
          "icon": "clock"
        }
      ]
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  },
  "searchText": [
    [
      "eyebrow"
    ],
    [
      "heading"
    ],
    {
      "path": [
        "body"
      ],
      "format": "prose"
    },
    [
      "items",
      "*",
      "title"
    ],
    {
      "path": [
        "items",
        "*",
        "description"
      ],
      "format": "prose"
    }
  ],
  "authoringActions": [
    {
      "path": [
        "items",
        "*",
        "link"
      ],
      "href": "href",
      "label": "label"
    }
  ]
}
