{
  "name": "core/feature-grid",
  "title": "Feature Grid",
  "description": "Grid of feature cards with a section intro.",
  "category": "marketing",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "3–6 features or benefits with short descriptions",
    "avoid": "more than 8 items (consider splitting)"
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 400
    },
    {
      "id": "items",
      "default": [],
      "type": "repeater",
      "max": 12,
      "fields": [
        {
          "id": "title",
          "default": "",
          "type": "text",
          "max": 80
        },
        {
          "id": "description",
          "default": "",
          "type": "text",
          "max": 300
        }
      ]
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": "",
      "items": []
    },
    {
      "eyebrow": "Highlights",
      "heading": "What makes it useful",
      "body": "Three reasons people choose ConvexPress.",
      "items": [
        {
          "title": "AI-first",
          "description": "Type a prompt, get a page."
        },
        {
          "title": "Skill-driven",
          "description": "Themes own the look."
        },
        {
          "title": "Real-time",
          "description": "Powered by Convex."
        }
      ]
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  }
}
