  "description": "Modern asymmetric feature layout \u2014 large + small cells.",
  "category": "marketing",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "Apple-style visual showcases",
    "avoid": ""
