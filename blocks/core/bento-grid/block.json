        {
          "id": "ctaLabel",
          "default": "",
          "type": "text",
          "max": 40
        },
        {
          "id": "ctaUrl",
          "default": "",
          "type": "link",
          "storage": "href",
          "allowEmpty": true
        }
      ]
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
