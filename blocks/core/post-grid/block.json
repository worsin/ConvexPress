{
  "name": "core/post-grid",
  "title": "Post grid",
  "description": "Posts by taxonomy query with pagination.",
  "category": "discovery",
  "role": "content",
  "version": 1,
  "keywords": [
    "post-grid"
  ],
  "ai": {
    "useFor": "Posts by taxonomy query with pagination.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "query",
      "type": "object",
      "fields": [
        {
          "id": "category",
          "type": "reference",
          "of": "category",
          "max": 256
        },
        {
          "id": "tag",
          "type": "reference",
          "of": "tag",
          "max": 256
        },
        {
          "id": "author",
          "type": "reference",
          "of": "user",
          "max": 256
        }
      ]
    },
    {
      "id": "limit",
      "type": "number",
      "min": 1,
      "max": 48,
      "integer": true,
      "default": 6
    },
    {
      "id": "showExcerpt",
      "type": "boolean",
      "default": true
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "content.posts",
    "args": {
      "query": "attrs.query",
      "limit": "attrs.limit",
      "showExcerpt": "attrs.showExcerpt"
    }
  },
  "preview": "Post grid",
  "examples": [
    {}
  ],
  "requires": {
    "plugins": [],
    "capabilities": [
      "reference.targetResolution"
    ]
  }
}
