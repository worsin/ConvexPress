{
  "name": "core/quote",
  "title": "Quote",
  "description": "A pull quote or blockquote with optional attribution.",
  "category": "text",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "memorable lines, source citations",
    "avoid": "multiple testimonials together (use core/testimonials)"
  },
  "fields": [
    {
      "id": "text",
      "default": null,
      "type": "text",
      "min": 1,
      "max": 800,
      "nullable": true
    },
    {
      "id": "cite",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "source",
      "default": "",
      "type": "link",
      "storage": "href",
      "allowEmpty": true
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "Quote",
  "examples": [
    {
      "text": null,
      "cite": "",
      "source": ""
    },
    {
      "text": "The best way to predict the future is to invent it.",
      "cite": "Alan Kay",
      "source": ""
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": [
      {
        "kind": "empty-to-null",
        "path": [
          "text"
        ]
      }
    ]
  }
}
