{
  "name": "core/pricing-table",
  "title": "Pricing table",
  "description": "Dense plan comparison table with toggles.",
  "category": "marketing",
  "role": "content",
  "version": 1,
  "keywords": [
    "pricing-table"
  ],
  "ai": {
    "useFor": "Dense plan comparison table with toggles.",
    "avoid": "Price labels are editorial copy, never checkout authority. Billing controls and real plans require a verified commerce resolver."
  },
  "fields": [
    {
      "id": "plans",
      "type": "repeater",
      "fields": [
        {
          "id": "name",
          "type": "text",
          "max": 160,
          "required": true,
          "min": 1
        },
        {
          "id": "description",
          "type": "text",
          "max": 1000,
          "default": ""
        },
        {
          "id": "priceLabel",
          "type": "text",
          "max": 160,
          "default": ""
        },
        {
          "id": "features",
          "type": "repeater",
          "item": {
            "id": "value",
            "type": "text",
            "max": 500,
            "required": true
          },
          "max": 30,
          "default": []
        },
        {
          "id": "cta",
          "type": "link"
        }
      ],
      "max": 8,
      "default": []
    },
    {
      "id": "rows",
      "type": "repeater",
      "fields": [
        {
          "id": "label",
          "type": "text",
          "max": 160,
          "required": true,
          "min": 1
        },
        {
          "id": "values",
          "type": "repeater",
          "item": {
            "id": "value",
            "type": "text",
            "max": 500,
            "required": true
          },
          "max": 8,
          "default": []
        }
      ],
      "max": 50,
      "default": []
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "Pricing table",
  "examples": [
    {
      "plans": [
        {
          "name": "Open notebook",
          "description": "A simple place to begin.",
          "priceLabel": "Free",
          "features": [
            "Read the field guide",
            "Try a short observation exercise"
          ]
        }
      ],
      "rows": []
    },
    {
      "plans": [
        {
          "name": "Open notebook",
