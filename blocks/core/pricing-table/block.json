    {
      "kind": "matrix",
      "headers": "plans",
      "rows": "rows",
      "rowField": "values"
    }
  ],
  "searchText": [
    [
      "plans",
      "*",
      "name"
    ],
    [
      "plans",
      "*",
      "description"
    ],
    [
      "plans",
      "*",
      "priceLabel"
    ],
    [
      "plans",
      "*",
