{
  "name": "core/process-steps",
  "title": "Process steps",
  "description": "Numbered step-by-step process.",
  "category": "marketing",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "how-it-works sections",
    "avoid": ""
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 300
    },
    {
      "id": "steps",
      "default": [],
      "type": "repeater",
      "max": 12,
      "fields": [
        {
          "id": "title",
          "default": "",
          "type": "text",
          "max": 80
        },
        {
          "id": "body",
          "default": "",
          "type": "text",
          "max": 400
        }
      ]
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": "",
      "steps": []
    },
    {
      "eyebrow": "How it works",
      "heading": "Three steps to ship",
      "body": "",
      "steps": [
        {
          "title": "Type a prompt",
          "body": "Describe the page."
        },
        {
          "title": "Polish",
          "body": "Drag and edit."
        },
        {
          "title": "Publish",
          "body": "One click."
        }
      ]
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  },
  "searchText": [
    [
      "eyebrow"
    ],
    [
      "heading"
    ],
    {
      "path": [
        "body"
      ],
      "format": "prose"
    },
    [
      "steps",
      "*",
      "title"
    ],
    {
      "path": [
        "steps",
        "*",
        "body"
      ],
      "format": "prose"
    }
  ]
}
