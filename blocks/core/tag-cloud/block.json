{
  "name": "core/tag-cloud",
  "title": "Tag cloud",
  "description": "An alphabetical collection of topics with accessible published stories.",
  "category": "site",
  "role": "aside",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "blog discovery sections",
    "avoid": ""
  },
  "fields": [
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "max",
      "default": 30,
      "type": "number",
      "min": 1,
      "max": 100,
      "integer": true
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "content.tags",
    "args": {
      "max": "attrs.max"
    }
  },
  "preview": "{heading}",
  "examples": [
    {
      "heading": "",
      "max": 30
    },
    {
      "heading": "Topics",
      "max": 30
    },
    {
      "heading": "Follow your curiosity",
      "max": 8
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  }
}
