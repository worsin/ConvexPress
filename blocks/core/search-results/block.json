{
  "name": "core/search-results",
  "title": "Search results",
  "description": "Bounded paginated site-search results for an explicit query and allowed content kinds.",
  "category": "discovery",
  "role": "content",
  "version": 1,
  "keywords": [
    "search-results"
  ],
  "ai": {
    "useFor": "Bounded paginated site-search results for an explicit query and allowed content kinds.",
    "avoid": "Search term and pagination come from validated request context. Resolve public visible content only; never expose draft or gated bodies in snippets."
  },
  "fields": [
    {
      "id": "queryBinding",
      "type": "select",
      "options": [
        "url"
      ],
      "default": "url"
    },
    {
      "id": "kinds",
      "type": "repeater",
      "item": {
        "id": "value",
        "type": "select",
        "options": [
          "post",
          "page",
          "product",
          "course",
          "event"
        ],
        "required": true
      },
      "max": 5,
      "default": []
    },
    {
      "id": "pageSize",
      "type": "number",
      "min": 1,
      "max": 48,
      "integer": true,
      "default": 12
    },
    {
      "id": "emptyMessage",
      "type": "text",
      "max": 500,
      "default": "No results found. Try a different search."
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "content.search",
    "args": {
      "kinds": "attrs.kinds",
      "pageSize": "attrs.pageSize"
    }
  },
  "preview": "Search results",
  "examples": [
    {}
  ],
  "requires": {
    "plugins": [],
    "capabilities": []
  }
}
