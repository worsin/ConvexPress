{
  "name": "core/steps-with-media",
  "title": "Steps with media",
  "description": "Sticky media that changes as the reader scrolls through steps.",
  "category": "marketing",
  "role": "content",
  "version": 1,
  "keywords": [
    "steps-with-media"
  ],
  "ai": {
    "useFor": "Sticky media that changes as the reader scrolls through steps.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "steps",
      "type": "repeater",
      "fields": [
        {
          "id": "title",
          "type": "text",
          "max": 160,
          "required": true,
          "min": 1
        },
        {
          "id": "body",
          "type": "richtext",
          "max": 12000
        },
        {
          "id": "media",
          "type": "media"
        }
      ],
      "max": 20,
      "default": []
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "Steps with media",
  "examples": [
    {
      "steps": [
        {
          "title": "Notice",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Pause beside something familiar and look for one detail you missed before."
                  }
                ]
              }
            ]
          }
        },
        {
          "title": "Record",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Write a sentence that another person could picture."
                  }
                ]
              }
            ]
          }
        }
      ]
    },
    {
      "steps": [
        {
          "title": "Begin with a question.",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Notice one detail you have walked past before."
                  }
                ]
              }
            ]
          },
          "media": {
            "id": "demo-image-field-notebook",
            "alt": "A notebook and pencil"
          }
        },
        {
          "title": "Give it a little time.",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Make an ordinary ritual a moment of attention."
                  }
                ]
              }
            ]
          },
          "media": {
            "id": "demo-image-camp-mug",
            "alt": "A useful ceramic cup"
          }
        },
        {
          "title": "Share what you found.",
          "body": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "Leave room for another person’s point of view."
                  }
                ]
              }
            ]
          },
          "media": {
            "id": "demo-image-retreat",
            "alt": "A gathering place near the forest"
          }
        }
      ]
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": [
      "reference.targetResolution"
    ]
  },
  "searchText": [
    [
      "steps",
      "*",
      "title"
    ],
    [
      "steps",
      "*",
      "body"
    ]
  ]
}
