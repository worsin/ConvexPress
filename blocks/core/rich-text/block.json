{
  "name": "core/rich-text",
  "title": "Rich Text Section",
  "description": "A copy-only section with eyebrow, heading, and body.",
  "category": "text",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "long-form copy sections with an eyebrow/heading/body structure",
    "avoid": ""
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": {
        "type": "doc",
        "content": []
      },
      "type": "richtext",
      "max": 2000,
      "inline": false
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": {
        "type": "doc",
        "content": []
      }
    },
    {
      "eyebrow": "Why ConvexPress",
      "heading": "Built for AI-first content",
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "..."
              }
            ]
          }
        ]
      }
    },
    {
      "eyebrow": "From the field notebook",
      "heading": "Attention is a practice.",
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Start with something ordinary. ",
                "marks": [
                  {
                    "type": "bold"
                  }
                ]
              },
              {
                "type": "text",
                "text": "A cup on a table, a tree outside the window, a familiar path. Stay with it long enough to notice one detail you missed yesterday."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Write a little. Leave some room.",
                "marks": [
                  {
                    "type": "italic"
                  }
                ]
              },
              {
                "type": "hardBreak"
              },
              {
                "type": "text",
                "text": "A notebook does not need to be polished to be useful."
              }
            ]
          },
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "Explore the field notes",
                "marks": [
                  {
                    "type": "link",
                    "attrs": {
                      "href": "/journal"
                    }
                  }
                ]
              },
              {
                "type": "text",
                "text": " for more prompts from this fictional studio."
              }
            ]
          }
        ]
      }
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": [
      {
        "kind": "text-to-richtext",
        "path": [
          "body"
        ],
        "mode": "plain-prose"
      }
    ]
  },
  "searchText": [
    [
      "eyebrow"
    ],
    [
      "heading"
    ],
    [
      "body"
    ]
  ]
}
