{
  "name": "core/logo-cloud",
  "title": "Logo cloud",
  "description": "Row of customer or partner logos.",
  "category": "marketing",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "social proof via brand logos",
    "avoid": ""
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "logos",
      "default": [],
      "type": "repeater",
      "max": 24,
      "fields": [
        {
          "id": "name",
          "default": "",
          "type": "text",
          "max": 80
        },
        {
          "id": "mediaId",
          "default": "",
          "type": "media",
          "storage": "id",
          "allowEmpty": true
        },
        {
          "id": "href",
          "default": "",
          "type": "link",
          "storage": "href",
          "allowEmpty": true
        }
      ]
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
