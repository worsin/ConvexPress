{
  "name": "core/testimonials",
  "title": "Testimonials",
  "description": "Customer quotes with attribution.",
  "category": "marketing",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "social proof sections",
    "avoid": "a single quote (use core/quote)"
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 400,
      "multiline": true
    },
    {
      "id": "items",
      "default": [],
      "type": "repeater",
      "max": 20,
      "fields": [
        {
          "id": "quote",
          "default": "",
          "type": "text",
          "max": 500
        },
        {
          "id": "name",
          "default": "",
          "type": "text",
          "max": 80
        },
        {
          "id": "role",
          "default": "",
          "type": "text",
          "max": 80
        },
        {
          "id": "portrait",
          "type": "media",
          "description": "Optional portrait with alt text and focal point."
        }
      ]
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": "",
      "items": []
    },
    {
      "eyebrow": "Fictional workshop voices",
      "heading": "Room to see things differently",
      "body": "Sample quotations and identities for the block demonstration.",
      "items": [
        {
          "quote": "A little space can change the way we see an ordinary day.",
          "name": "Rowan Vale",
          "role": "Fictional workshop guest",
          "portrait": {
            "id": "demo-image-studio-portrait",
            "alt": "AI-generated fictional studio collaborator",
            "focalPoint": {
              "x": 0.5,
              "y": 0.35
            }
          }
        },
        {
          "quote": "There is always another detail worth noticing.",
          "name": "Ellis Reed",
          "role": "Fictional notebook editor"
        }
      ]
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  },
  "searchText": [
    [
      "eyebrow"
    ],
    [
      "heading"
    ],
    {
      "path": [
        "body"
      ],
      "format": "prose"
    },
    [
      "items",
      "*",
      "quote"
    ],
    [
      "items",
      "*",
      "name"
    ],
    [
      "items",
      "*",
      "role"
    ]
  ]
}
