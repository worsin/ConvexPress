{
  "name": "core/definition-list",
  "title": "Definition list",
  "description": "Semantic terms and definitions for glossaries, specifications and service details.",
  "category": "text",
  "role": "content",
  "version": 1,
  "keywords": [
    "definition-list"
  ],
  "ai": {
    "useFor": "Semantic terms and definitions for glossaries, specifications and service details.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "items",
      "type": "repeater",
      "fields": [
        {
          "id": "term",
          "type": "text",
          "max": 160,
          "required": true,
          "min": 1
        },
        {
          "id": "definition",
          "type": "richtext",
          "max": 12000
        }
      ],
      "max": 50,
      "default": []
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "Definition list",
  "examples": [
    {
      "items": [
        {
          "term": "Field note",
          "definition": {
            "type": "doc",
            "content": [
              {
                "type": "paragraph",
                "content": [
                  {
                    "type": "text",
                    "text": "A brief observation recorded where it happened."
                  }
                ]
              }
            ]
          }
        }
      ]
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": []
  }
}
