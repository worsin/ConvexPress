{
  "name": "core/event-rsvp",
  "title": "Event RSVP",
  "description": "RSVP form for an event.",
  "category": "forms",
  "role": "cta",
  "version": 1,
  "keywords": [
    "event-rsvp"
  ],
  "ai": {
    "useFor": "RSVP form for an event.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "event",
      "type": "reference",
      "of": "event",
      "max": 256,
      "storage": "id"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "events.event",
    "args": {
      "event": "attrs.event",
      "blockId": "block.id"
    }
  },
  "preview": "Event RSVP",
  "examples": [
    {}
  ],
  "requires": {
    "plugins": [
      "forms"
    ],
    "capabilities": [
      "form.submission",
      "reference.targetResolution"
    ]
  }
}
