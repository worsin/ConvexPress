{
  "name": "core/latest-posts",
  "title": "Latest posts",
  "description": "Auto-list of recent blog posts.",
  "category": "site",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "homepage blog teaser",
    "avoid": ""
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 300
    },
    {
      "id": "count",
      "default": 3,
      "type": "number",
      "min": 1,
      "max": 24,
      "integer": true
    },
    {
      "id": "categorySlug",
      "default": "",
      "type": "reference",
      "max": 120,
      "of": "category",
      "storage": "slug",
      "allowEmpty": true
    },
    {
      "id": "tagSlug",
      "default": "",
      "type": "reference",
      "max": 120,
      "of": "tag",
      "storage": "slug",
      "allowEmpty": true
    },
    {
      "id": "showExcerpts",
      "default": true,
      "type": "boolean"
    },
    {
      "id": "showAuthors",
      "default": true,
      "type": "boolean"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "content.latestPosts",
    "args": {
      "count": "attrs.count",
      "categorySlug": "attrs.categorySlug",
      "tagSlug": "attrs.tagSlug",
      "showAuthors": "attrs.showAuthors",
      "showExcerpts": "attrs.showExcerpts"
    }
  },
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": "",
      "count": 3,
      "categorySlug": "",
      "tagSlug": "",
      "showExcerpts": true,
      "showAuthors": true
    },
    {
      "eyebrow": "",
      "heading": "From the blog",
      "body": "",
      "count": 3,
      "categorySlug": "",
      "tagSlug": "",
      "showExcerpts": true,
      "showAuthors": true
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  }
}
