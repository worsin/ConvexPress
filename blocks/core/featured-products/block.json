{
  "name": "core/featured-products",
  "title": "Featured products",
  "description": "A product grid with hand-picked products or the latest added products, resolved from the current store.",
  "category": "commerce",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "store homepage, product showcases",
    "avoid": ""
  },
  "fields": [
    {
      "id": "eyebrow",
      "default": "",
      "type": "text",
      "max": 80
    },
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 300
    },
    {
      "id": "productIds",
      "default": [],
      "type": "repeater",
      "max": 12,
      "item": {
        "id": "value",
        "required": true,
        "type": "reference",
        "of": "product",
        "storage": "id",
        "allowEmpty": true
      }
    },
    {
      "id": "count",
      "default": 4,
      "type": "number",
      "min": 1,
      "max": 12,
      "integer": true
    },
    {
      "id": "showPrice",
      "default": true,
      "type": "boolean"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "commerce.featuredProducts",
    "args": {
      "productIds": "attrs.productIds",
      "count": "attrs.count",
      "showPrice": "attrs.showPrice"
    }
  },
  "preview": "{heading}",
  "examples": [
    {
      "eyebrow": "",
      "heading": "",
      "body": "",
      "productIds": [],
      "count": 4,
      "showPrice": true
    },
    {
      "eyebrow": "",
      "heading": "Featured",
      "body": "",
      "productIds": [],
      "count": 4,
      "showPrice": true
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  },
  "requires": {
    "plugins": [
      "commerce"
    ],
    "capabilities": []
  }
}
