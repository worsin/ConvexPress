{
  "name": "core/lead-magnet",
  "title": "Lead magnet",
  "description": "Download in exchange for email.",
  "category": "forms",
  "role": "cta",
  "version": 1,
  "keywords": [
    "lead-magnet"
  ],
  "ai": {
    "useFor": "Download in exchange for email.",
    "avoid": "Use an explicit consent flow and real download. No automatic email, list enrollment, tracking or entitlement bypass may occur on render."
  },
  "fields": [
    {
      "id": "title",
      "type": "text",
      "max": 160,
      "default": ""
    },
    {
      "id": "body",
      "type": "richtext",
      "max": 12000
    },
    {
      "id": "media",
      "type": "media"
    },
    {
      "id": "file",
      "type": "media"
    },
    {
      "id": "list",
      "type": "reference",
      "of": "mailingList",
      "max": 256,
      "storage": "id"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "forms.leadMagnet",
    "args": {
      "blockId": "block.id"
    }
  },
  "preview": "Lead magnet",
  "examples": [
    {
      "title": "Make a field notebook",
      "body": {
        "type": "doc",
        "content": [
          {
            "type": "paragraph",
            "content": [
              {
                "type": "text",
                "text": "A short guide for recording the small things you notice."
              }
            ]
          }
        ]
      }
    }
  ],
  "requires": {
    "plugins": [
      "forms"
    ],
    "capabilities": [
      "form.submission",
      "reference.targetResolution"
    ]
  },
  "searchText": [
    [
      "title"
    ],
    [
      "body"
    ]
  ]
}
