{
  "name": "core/accordion",
  "title": "Accordion",
  "description": "Collapsible Q&A or progressive-disclosure list.",
  "category": "layout",
  "role": "content",
  "version": 2,
  "keywords": [],
  "ai": {
    "useFor": "FAQ-adjacent content, docs sections",
    "avoid": ""
  },
  "fields": [
    {
      "id": "heading",
      "default": "",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 300
    },
    {
      "id": "items",
      "default": [],
      "type": "repeater",
      "max": 40,
      "fields": [
        {
          "id": "title",
          "default": "",
          "type": "text",
          "max": 120
        },
        {
          "id": "body",
          "default": "",
          "type": "text",
          "max": 2000
        }
      ]
    },
    {
      "id": "defaultOpen",
      "default": 0,
      "type": "number",
      "min": 0
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "heading": "",
      "body": "",
      "items": [],
      "defaultOpen": 0
    },
    {
      "heading": "Details",
      "body": "",
      "items": [
        {
          "title": "What's included?",
          "body": "Everything in the core plan."
        }
      ],
      "defaultOpen": 0
    }
  ],
  "migration": {
    "fromVersion": 1,
    "preserveLegacyRender": true,
    "transforms": []
  }
}
