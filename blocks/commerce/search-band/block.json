{
  "name": "commerce/search-band",
  "title": "Search band",
  "description": "Product search input with suggested queries.",
  "category": "commerce",
  "role": "utility",
  "version": 1,
  "keywords": [
    "search-band"
  ],
  "ai": {
    "useFor": "Product search input with suggested queries.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "placeholder",
      "type": "text",
      "max": 160,
      "default": "Search products"
    },
    {
      "id": "suggestions",
      "type": "repeater",
      "item": {
        "id": "value",
        "type": "text",
        "max": 160,
        "required": true
      },
      "max": 12,
      "default": []
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "Search band",
  "examples": [
    {},
    {
      "placeholder": "Find a notebook, a useful cup…",
      "suggestions": [
        "Field notebook",
        "Ceramic mug",
        "Workshop materials"
      ]
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": []
  }
}
