{
  "name": "commerce/product-hero",
  "title": "Product hero",
  "description": "Single product spotlight with price and add to cart.",
  "category": "commerce",
  "role": "hero",
  "version": 1,
  "keywords": [
    "product-hero"
  ],
  "ai": {
    "useFor": "Single product spotlight with price and add to cart.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "product",
      "type": "reference",
      "of": "product",
      "max": 256,
      "storage": "id"
    },
    {
      "id": "title",
      "type": "text",
      "max": 160,
      "default": ""
    },
    {
      "id": "media",
      "type": "media"
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "commerce.productCollection",
    "args": {
      "mode": "manual",
      "productIds": [
        "attrs.product"
      ],
      "count": 1,
      "showPrice": true,
      "showRating": false,
      "showAddToCart": true,
      "groups": []
    }
  },
  "preview": "Product hero",
  "examples": [
    {
      "product": "demo-product-notebook",
      "title": "The things we keep close."
    },
    {
      "product": "demo-product-mug",
      "title": ""
    },
    {}
  ],
  "requires": {
    "plugins": [
      "commerce"
    ],
    "capabilities": [
      "reference.targetResolution"
    ]
  }
}
