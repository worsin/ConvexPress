{
  "name": "business/service-list",
  "title": "Services and rates",
  "description": "Structured services with descriptions, duration, indicative pricing and enquiry links.",
  "category": "marketing",
  "role": "content",
  "version": 1,
  "keywords": [
    "service-list"
  ],
  "ai": {
    "useFor": "Structured services with descriptions, duration, indicative pricing and enquiry links.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "services",
      "type": "repeater",
      "fields": [
        {
          "id": "name",
          "type": "text",
          "max": 160,
          "required": true,
          "min": 1
        },
        {
          "id": "description",
          "type": "text",
          "max": 2000,
          "default": ""
        },
        {
          "id": "duration",
          "type": "text",
          "max": 160,
          "default": ""
        },
        {
          "id": "priceLabel",
          "type": "text",
          "max": 160,
          "default": ""
        },
        {
          "id": "link",
          "type": "link"
        }
      ],
      "max": 50,
      "default": []
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "Services and rates",
  "examples": [
    {
      "services": [
        {
          "name": "Field notebook workshop",
          "description": "A guided introduction to recording everyday observations.",
          "duration": "",
          "priceLabel": ""
        }
      ]
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": []
  }
}
