            }
          ]
        }
      ]
    }
  ],
  "requires": {
    "plugins": [],
    "capabilities": []
  },
  "searchText": [
    [
      "sections",
      "*",
      "title"
    ],
    [
      "sections",
      "*",
      "items",
      "*",
      "name"
    ],
    [
      "sections",
      "*",
      "items",
      "*",
      "description"
    ],
    [
      "sections",
      "*",
      "items",
      "*",
