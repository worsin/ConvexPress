{
  "name": "blocks/social-share",
  "title": "Social Share",
  "description": "A compact share panel for marketing pages, product stories, posts, and media features.",
  "category": "site",
  "role": "utility",
  "version": 1,
  "keywords": [
    "site",
    "share",
    "social",
    "facebook",
    "pinterest",
    "email"
  ],
  "ai": {
    "useFor": "share prompts near stories, media pages, or product/customer showcases",
    "avoid": "site footer social profile links"
  },
  "fields": [
    {
      "id": "heading",
      "default": "Share this page",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "",
      "type": "text",
      "max": 500
    },
    {
      "id": "networks",
      "default": [
        "facebook",
        "x",
        "pinterest",
        "email"
      ],
      "type": "repeater",
      "max": 8,
      "item": {
        "id": "value",
        "required": true,
        "type": "select",
        "options": [
          "facebook",
          "x",
          "pinterest",
          "linkedin",
          "email",
          "copy"
        ]
      }
    },
    {
      "id": "shareUrlMode",
      "default": "currentPage",
      "type": "select",
      "options": [
        "currentPage",
        "custom"
      ]
    },
    {
      "id": "customUrl",
      "default": "",
      "type": "text",
      "max": 500
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "heading": "Share this page",
      "body": "",
      "networks": [
        "facebook",
        "x",
        "pinterest",
        "email"
      ],
      "shareUrlMode": "currentPage",
      "customUrl": ""
    },
    {
      "heading": "Share this page",
      "body": "",
      "networks": [
        "facebook",
        "x",
        "pinterest",
        "email"
      ],
      "shareUrlMode": "currentPage",
      "customUrl": ""
    },
    {
      "heading": "Pass a little inspiration along.",
      "body": "Share this fictional editorial study. No message is sent until you choose a destination.",
      "networks": [
        "facebook",
        "x",
        "pinterest",
        "linkedin",
        "email",
        "copy"
      ],
      "shareUrlMode": "custom",
      "customUrl": "https://example.invalid/editorial-study"
    }
  ]
}
