{
  "name": "membership/gated-teaser",
  "title": "Gated teaser",
  "description": "Preview with an upgrade prompt for gated content.",
  "category": "plugin",
  "role": "content",
  "version": 1,
  "keywords": [
    "gated-teaser"
  ],
  "ai": {
    "useFor": "Preview with an upgrade prompt for gated content.",
    "avoid": "Only public teaser text belongs in page content. Resolve access on the server; hiding a rendered body is never authorization."
  },
  "fields": [
    {
      "id": "teaserText",
      "type": "text",
      "max": 2000,
      "default": ""
    },
    {
      "id": "requiredPlan",
      "type": "reference",
      "of": "membershipPlan",
      "max": 256,
      "storage": "id"
    },
    {
      "id": "upgradeLink",
      "type": "link",
      "storage": "href",
      "allowEmpty": true,
      "default": ""
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "membership.access",
    "args": {
      "plan": "attrs.requiredPlan"
    }
  },
  "preview": "Gated teaser",
  "examples": [
    {},
    {
      "teaserText": "A closer look at the materials, the process, and the people behind the work.",
      "requiredPlan": "demo-membership-studio",
      "upgradeLink": "/membership-options"
    }
  ],
  "requires": {
    "plugins": [
      "membership"
    ],
    "capabilities": [
      "viewer.authorization",
      "reference.targetResolution"
    ]
  }
}
