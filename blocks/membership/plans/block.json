{
  "name": "membership/plans",
  "title": "Membership plans",
  "description": "Plan cards from the Membership extension.",
  "category": "plugin",
  "role": "content",
  "version": 1,
  "keywords": [
    "plans"
  ],
  "ai": {
    "useFor": "Plan cards from the Membership extension.",
    "avoid": "Do not invent records, permissions, prices, endorsements or resource identifiers. Presentation comes from the selected template."
  },
  "fields": [
    {
      "id": "selection",
      "type": "select",
      "options": [
        "all",
        "selected"
      ],
      "default": "all"
    },
    {
      "id": "plans",
      "type": "repeater",
      "item": {
        "id": "value",
        "type": "reference",
        "of": "membershipPlan",
        "max": 256,
        "required": true,
        "storage": "id"
      },
      "max": 12,
      "default": []
    },
    {
      "id": "limit",
      "type": "number",
      "min": 1,
      "max": 12,
      "integer": true,
      "default": 6
    },
    {
      "id": "heading",
      "type": "text",
      "max": 200,
      "default": "A place to belong."
    },
    {
      "id": "introduction",
      "type": "text",
      "max": 2000,
      "default": ""
    },
    {
      "id": "actionLabel",
      "type": "text",
      "max": 160,
      "default": "Ask about membership"
    },
    {
      "id": "actionLink",
      "type": "link",
      "storage": "href",
      "allowEmpty": true,
      "default": ""
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": {
    "resolver": "membership.plans",
    "args": {
      "selection": "attrs.selection",
      "plans": "attrs.plans",
      "limit": "attrs.limit"
    }
  },
  "preview": "Membership plans",
  "examples": [
    {},
    {
      "selection": "selected",
      "plans": [
        "demo-plan-studio",
        "demo-plan-circle",
        "demo-plan-workshop"
      ],
      "limit": 3,
      "heading": "Find your place in the studio.",
      "introduction": "Come for the craft. Stay for the conversations, the shared table, and the things we make together.",
      "actionLink": "/contact",
      "actionLabel": "Let’s find your membership"
    }
  ],
  "requires": {
    "plugins": [
      "membership"
    ],
    "capabilities": [
      "reference.targetResolution"
    ]
  },
  "searchText": [
    [
      "heading"
    ],
    [
      "introduction"
    ]
  ]
}
