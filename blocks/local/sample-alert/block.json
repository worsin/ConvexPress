{
  "name": "local/sample-alert",
  "title": "Sample Alert",
  "description": "A local proof-of-registration alert block with a heading, body, variant, and optional CTA.",
  "category": "site",
  "role": "content",
  "version": 1,
  "keywords": [
    "alert",
    "notice",
    "local",
    "sample"
  ],
  "ai": {
    "useFor": "site-specific notices, warnings, updates, or compact callouts",
    "avoid": "long-form prose or major marketing sections"
  },
  "fields": [
    {
      "id": "heading",
      "default": "Important update",
      "type": "text",
      "max": 120
    },
    {
      "id": "body",
      "default": "Add the alert copy here.",
      "type": "text",
      "max": 800
    },
    {
      "id": "variant",
      "default": "info",
      "type": "select",
      "options": [
        "info",
        "success",
        "warning"
      ]
    },
    {
      "id": "ctaLabel",
      "default": "",
      "type": "text",
      "max": 40
    },
    {
      "id": "ctaUrl",
      "default": "",
      "type": "text",
      "max": 300
    }
  ],
  "supports": {
    "children": false,
    "styles": true,
    "layout": [
      "width",
      "tone",
      "spacing",
      "align"
    ],
    "anchor": true,
    "visibility": true
  },
  "data": null,
  "preview": "{heading}",
  "examples": [
    {
      "heading": "Important update",
      "body": "Add the alert copy here.",
      "variant": "info",
      "ctaLabel": "",
      "ctaUrl": ""
    },
    {
      "heading": "Important update",
      "body": "Add the alert copy here.",
      "variant": "info",
      "ctaLabel": "",
      "ctaUrl": ""
    },
    {
      "heading": "A note from the imagined workshop.",
      "body": "This is sample information for the block study. No booking or service status has changed.",
      "variant": "info",
      "ctaLabel": "Read the studies",
      "ctaUrl": "#studies"
    }
  ],
  "authoringActions": [
    {
      "path": [],
      "href": "ctaUrl",
      "label": "ctaLabel"
    }
  ]
}
