                "text": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Begin with a question"
                        }
                      ]
                    }
                  ]
                }
              }
            },
            {
              "id": "note-0-copy-0",
              "name": "core/paragraph",
              "version": 2,
              "attrs": {
                "body": {
                  "type": "doc",
                  "content": [
                    {
                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "Write down what brought someone to the page. Then give them an answer in words you would use in conversation. A heading should help that person recognize the answer quickly."
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
        },
