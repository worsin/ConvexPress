                      "type": "paragraph",
                      "content": [
                        {
                          "type": "text",
                          "text": "If two sections make the same point, combine them. If a section has no useful next step or supporting detail, question whether it belongs."
                        }
                      ]
                    }
                  ]
                }
              }
            }
          ]
